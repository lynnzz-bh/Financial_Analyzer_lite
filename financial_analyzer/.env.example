# DeepSeek 与 Qwen API Key 默认为空。使用前请复制为 .env 并手动填写真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# 东方财富网相关 AKShare 接口强制使用 akshare-proxy-patch，请手动配置 token。
AKSHARE_PROXY_TOKEN=
AKSHARE_PROXY_GATEWAY=101.201.173.125
AKSHARE_PROXY_RETRY=30
AKSHARE_PROXY_FAST=true
